<div id="cash" class="tab-pane fade in <%= 'active' if index == 0 %>">
  <%= form_tag update_checkout_path(@order.state), method: :patch do %>
      <%= hidden_field_tag "order[payments_attributes][payment_method_id]", payment_method('PaymentMethod::Cash'), id: 'payment-cash' %>
      <h3>Cash On Delivery</h3>

      <p>
        Please pay <b> <%= @order.net_total %> </b> when received delivery.
      </p>

      <p>
        <%= submit_tag "Confirm & Place Order", class: "place-order-btn pull-right" %>
      </p>
  <% end %>
</div>